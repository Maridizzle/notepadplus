{
  "name": "notepad-plus-win7",
  "version": "1.0.0",
  "description": "NotepadPlus - Windows 7 compatible build (Electron 22)",
  "main": "main.js",
  "scripts": {
    "setup": "node setup.js",
    "build": "node build.js",
    "start": "npm run build && electron .",
    "dist": "npm run setup && npm run build && electron-builder --win",
    "dist:win": "npm run setup && npm run build && electron-builder --win"
  },
  "author": "Maridizzle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maridizzle/notepadplus.git"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-php": "^6.0.1",
    "@codemirror/lang-python": "^6.1.0",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.0",
    "codemirror": "^6.0.1",
    "diff": "^9.0.0"
  },
  "build": {
    "appId": "com.maridizzle.notepadplus",
    "productName": "NotepadPlus-Win7",
    "files": [
      "main.js",
      "preload.js",
      "src/index.html",
      "src/styles.css",
      "src/dist/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
