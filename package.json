{
  "name": "notepad-plus",
  "version": "1.0.0",
  "description": "A Notepad++ inspired editor with wiki-style file links, custom fonts, background colors, and Grammarly compatibility",
  "main": "main.js",
  "scripts": {
    "build": "node build.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "author": "Maridizzle",
  "homepage": "https://github.com/Maridizzle/notepadplus",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.23.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-php": "^6.0.1",
    "@codemirror/lang-python": "^6.1.0",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.0",
    "codemirror": "^6.0.1",
    "diff": "^9.0.0"
  },
  "build": {
    "appId": "com.maridizzle.notepadplus",
    "productName": "NotepadPlus",
    "files": [
      "main.js",
      "preload.js",
      "src/index.html",
      "src/styles.css",
      "src/dist/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": null
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "pacman",
        "AppImage"
      ],
      "category": "TextEditor",
      "maintainer": "Maridizzle <208540667+Maridizzle@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
